<Window x:Class="StreamZilla.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamZilla"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <ContextMenu x:Key="LocalItemMenu">
            <MenuItem Header="New folder"
                      Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Delete"
                      Command="{Binding PlacementTarget.Tag.DeleteLocalItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <ContextMenu x:Key="RemoteItemMenu">
            <MenuItem Header="New folder"
                      Command="{Binding PlacementTarget.Tag.NewRemoteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Delete"
                      Command="{Binding PlacementTarget.Tag.DeleteRemoteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <Style x:Key="ExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow"
                                  Data="M 0 0 L 4 4 L 0 8"
                                  Stroke="#666666"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoteItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="ContextMenu" Value="{StaticResource RemoteItemMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Padding="2" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Style="{StaticResource ExpanderToggleStyle}"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}"/>
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="PART_ItemsHost" Margin="16,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="PART_ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A90D9"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F80C4"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="TreeViewItem.Expanded" Handler="RemoteItem_Expanded"/>
            <EventSetter Event="TreeViewItem.Collapsed" Handler="RemoteItem_Collapsed"/>
        </Style>

        <Style x:Key="LocalItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource RemoteItemStyle}">
            <Setter Property="ContextMenu" Value="{StaticResource LocalItemMenu}"/>
            <EventSetter Event="TreeViewItem.Expanded" Handler="LocalItem_Expanded"/>
            <EventSetter Event="TreeViewItem.Collapsed" Handler="LocalItem_Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300" MinHeight="150"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Connection" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <TextBox Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="4" Text="User" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <TextBox Grid.Column="5" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="6" Text="Password" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <PasswordBox Grid.Column="7" x:Name="PasswordBox"/>
                <TextBlock Grid.Column="8" Text="Max streams per file (1-8)" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <TextBox Grid.Column="9" Width="45" Text="{Binding MaxStreamsPerFile, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="10" Text="Max concurrent files (1-8)" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <TextBox Grid.Column="11" Text="{Binding MaxConcurrentFiles, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="12" Content="Connect" Margin="10,0,0,0" Command="{Binding ConnectCommand}"/>
                <Button Grid.Column="13" Content="Disconnect" Margin="8,0,0,0" Command="{Binding DisconnectCommand}"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Local Computer" Margin="0,0,5,0">
                <TreeView x:Name="LocalTree"
                          ItemsSource="{Binding LocalRoots}"
                          ItemContainerStyle="{StaticResource LocalItemStyle}"
                          AllowDrop="True"
                          Drop="LocalTree_Drop"
                          DragOver="LocalTree_DragOver"
                          PreviewMouseLeftButtonDown="LocalTree_MouseDown"
                          MouseMove="LocalTree_MouseMove"
                          PreviewKeyDown="LocalTree_PreviewKeyDown"
                          SelectedItemChanged="LocalTree_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding IconImage}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SizeDisplay}" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="SFTP Remote Files" Margin="5,0,0,0">
                <TreeView x:Name="RemoteTree"
                          ItemsSource="{Binding RemoteRoots}"
                          ItemContainerStyle="{StaticResource RemoteItemStyle}"
                          AllowDrop="True"
                          Drop="RemoteTree_Drop"
                          DragOver="RemoteTree_DragOver"
                          PreviewMouseLeftButtonDown="RemoteTree_MouseDown"
                          MouseMove="RemoteTree_MouseMove"
                          SelectedItemChanged="RemoteTree_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="{Binding IconImage}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SizeDisplay}"
                                           Foreground="Gray"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           ToolTip="Size"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </GroupBox>
        </Grid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      Background="#DDDDDD"/>

        <GroupBox Grid.Row="3" Header="Downloads" Margin="0,6,0,0">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Pause all" Command="{Binding PauseAllCommand}" Margin="0,0,8,0"/>
                    <Button Content="Resume all" Command="{Binding ResumeAllCommand}" Margin="0,0,8,0"/>
                    <Button Content="Clear queue" Command="{Binding ClearQueueCommand}" Margin="0,0,8,0"/>
                    <Button Content="Remove selected"
                            Command="{Binding RemoveSelectedCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=DownloadsGrid}"/>
                    <TextBlock Text="Downloaded:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <TextBlock Text="{Binding QueueCountDisplay}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Size:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <TextBlock Text="{Binding TotalSizeDisplay}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Total:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <TextBlock Text="{Binding TotalSpeedDisplay}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Log:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <TextBlock Text="{Binding LogPath, RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="DownloadsGrid"
                          ItemsSource="{Binding Downloads}"
                          SelectedItem="{Binding SelectedDownload}"
                          SelectionMode="Extended"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Direction" Binding="{Binding DirectionDisplay}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="220" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Progress" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="16"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Amount" Binding="{Binding SizeDisplay}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Speed" Binding="{Binding SpeedDisplay}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ETA" Binding="{Binding EtaDisplay}" Width="90" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Pause"
                                                IsEnabled="{Binding CanPause}"
                                                Command="{Binding DataContext.PauseDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE769;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Resume"
                                                IsEnabled="{Binding CanResume}"
                                                Command="{Binding DataContext.ResumeDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE768;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
